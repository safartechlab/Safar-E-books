{
  "name": "safar-ebooks",
  "private": true,
  "description": "Helper scripts for building and starting the whole project from the top folder",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev"
  }
}