# Copy this file to ".env" (same folder) and fill in YOUR OWN values.
# NEVER commit or share the real .env file.

PORT=5000

# Comma-separated list of allowed website addresses (no trailing slash needed).
# Leave empty only for local development.
CORS_ORIGIN=

# Set to "true" if this server should also serve the built website (client/dist)
SERVE_CLIENT=

MONGODB_URI=mongodb://127.0.0.1:27017/ebook_platform

# Long random text. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Email: smtp (Gmail), resend or brevo
EMAIL_PROVIDER=smtp
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
RESEND_API_KEY=
BREVO_API_KEY=

# Razorpay (use rzp_test_ keys until you go live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# REQUIRED for the payment webhook to work. Set the same secret in
# Razorpay Dashboard -> Settings -> Webhooks, URL: https://YOUR-DOMAIN/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

SUBSCRIPTION_PRICE=299
SUBSCRIPTION_DURATION_DAYS=30

# Cloudinary (book covers + private PDFs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
